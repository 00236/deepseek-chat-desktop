{
  "name": "deepseek-chat-desktop",
  "version": "1.1.0",
  "description": "Windows 桌面 AI 聊天软件 - 接入 DeepSeek API",
  "author": "Local",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env DEV=true electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.local.deepseekchat",
    "productName": "DeepSeek Chat",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-store": "8.1.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^3.11.174",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.10",
    "wait-on": "^7.2.0"
  }
}
